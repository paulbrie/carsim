# Auth.js: a long random string (openssl rand -base64 32). Also signs the race WebSocket tickets.
AUTH_SECRET=
# Google OAuth client (Google Cloud console → APIs & Services → Credentials → OAuth client ID, "Web application").
# Authorized redirect URI: https://<your domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Name-only guest sign-in: on in development; in production only with AUTH_GUEST=1 (AUTH_GUEST=0 turns it off everywhere)
# AUTH_GUEST=1
# The site's public address, for links shared from it (the share image); default https://carsim.paulbrie.com
# SITE_URL=
# Railway sets PORT; locally the server defaults to 7001
# PORT=7001
# Serve under a path instead of the root, e.g. behind a proxy that keeps the prefix (the Genie box: /projects/carsim)
# BASE_PATH=/projects/carsim
# Public hosts `next dev` is reached through (comma-separated), e.g. paul.cloud.teleporthq.ai
# ALLOWED_DEV_ORIGINS=
# Postgres: the maps, the best laps, the saved autopilots (README: The database). The server won't start without it.
# Development: `docker compose up -d`, then this. On Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://carsim:carsim@127.0.0.1:5554/carsim
# Only for the first start with a database: where the files of before it are (maps, records.json, ghosts,
# autopilots; default ./data), read in once
# DATA_DIR=
# The Claude bridge without a code (#348): an agent on this machine with this key (24+ characters) takes the super admin's
# open tabs (scripts/bridge.mjs pages / take), which pair by themselves. The dev box only: leave it unset on the deployed site.
# CLAUDE_BRIDGE_AGENT_KEY=
